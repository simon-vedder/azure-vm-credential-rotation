# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# A saved plan is a zip that embeds the state it was planned against, so it carries
# subscription and tenant ids even when the variables file it came from is ignored.
*.tfplan
*.tfplan.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.terraform.lock.hcl

# PowerShell
*.psproj
TestResults*.xml
coverage*.xml

# Editors and OS
.DS_Store
.vscode/
.idea/
*.swp

# Never commit key material, even from a test run
*.pem
*.key
id_rsa*
*.ppk
