// | where ResultType == "Success"
// | where isnotempty(identity_claim_upn_s)
// | extend SecretName = tostring(split(tostring(parse_url(requestUri_s).Path), "/")[2])
// | summarize LastAccessedAt = max(TimeGenerated), AccessCount = count()
//     by SecretName, AccessedBy = identity_claim_upn_s
