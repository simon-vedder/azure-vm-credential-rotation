// Who read a credential, and when.
//
// This is the query the runbook itself runs to drive access-based rotation. Run it
// yourself after your first manual secret read to confirm the schema matches your
// workspace - the column names below are the one part of this project that has to be
// verified against a live tenant.
//
// It targets AZKVAuditLogs, the resource-specific table. That table only exists when
// the Key Vault diagnostic setting uses "Dedicated" as its destination type, which is
// what the observability module configures. If your diagnostic setting predates that,
// your events are in AzureDiagnostics with different column names - see the bottom of
// this file.
//
// Reads without a upn claim are excluded on purpose: those are applications and
// managed identities, and rotating a credential out from under a running workload
// breaks it.

let LookbackHours = 24;
let VaultName = "kv-credentials";           // adjust
AZKVAuditLogs
| where TimeGenerated > ago(LookbackHours * 1h)
| where OperationName == "SecretGet"
| where ResultType == "Success"
| where tolower(tostring(split(_ResourceId, "/")[-1])) == tolower(VaultName)
| extend Upn = tostring(Identity.claim.upn)
| where isnotempty(Upn)
| extend SecretName = tostring(split(tostring(parse_url(RequestUri).Path), "/")[2])
| where isnotempty(SecretName)
| where SecretName !endswith "-pending"     // staging secrets, read by the tool itself
| summarize LastAccessedAt = max(TimeGenerated), AccessCount = count() by SecretName, Upn
| project SecretName, LastAccessedAt, AccessedBy = Upn, AccessCount
| order by LastAccessedAt desc


