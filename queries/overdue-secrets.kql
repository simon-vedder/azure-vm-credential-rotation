// Credentials that should have been rotated and were not.
//
// This is the health check that matters. Alerting on failed jobs misses the worst
// case, which is a job that never ran at all - a disabled schedule, an expired role
// assignment, a deleted runbook. None of those produce a failure; they produce
// silence.
//
// Two signals, both worth watching:
//   1. machines that have been skipped repeatedly (almost always powered off)
//   2. no rotation activity at all in a window where there should have been some
//
// Note that Key Vault does not enforce expiry on secrets: an expired secret can still
// be read, deliberately, for recovery. An overdue credential is a hygiene problem, not
// an outage - which is exactly why it goes unnoticed without a query like this.

let SkipThresholdHours = 48;
let HeartbeatWindowHours = 12;
//
// 1. stuck machines
//
CredentialRotation_CL
| where TimeGenerated > ago(14d)
| where Result in ("Skipped", "Failed")
| summarize
    Attempts = count(),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated),
    LastDetail = arg_max(TimeGenerated, Detail).Detail
    by VMName, SecretName, CredentialType, Result
| extend StuckForHours = round(toreal(datetime_diff("minute", LastSeen, FirstSeen)) / 60.0, 1)
| where StuckForHours >= SkipThresholdHours
| project VMName, SecretName, CredentialType, Result, Attempts, StuckForHours, LastSeen, LastDetail
| order by StuckForHours desc

//
// 2. dead man's switch - run separately, alert if this returns a row
//
// CredentialRotation_CL
// | where TimeGenerated > ago(HeartbeatWindowHours * 1h)
// | summarize Records = count()
// | where Records == 0
//
// A run that finds nothing to do writes no records, so tune the window to comfortably
// exceed your schedule interval, or emit a heartbeat record on every run.
